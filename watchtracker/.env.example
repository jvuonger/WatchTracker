# Postgres connection string, e.g.:
# postgresql://user:password@host:5432/dbname?schema=public
DATABASE_URL=""

# eBay Finding API App ID (Client ID)
EBAY_APP_ID=""
# Optional: 'production' (default) or 'sandbox'
EBAY_ENV="production"

# Minimum interval between eBay API calls in milliseconds (per process)
# Defaults to 1200ms if unset
EBAY_MIN_INTERVAL_MS="1200"

# Secret to authorize cron calls to ingest endpoint
CRON_KEY=""

# eBay Marketplace Account Deletion verification token
EBAY_MAD_TOKEN=""
# The exact HTTPS endpoint you configured in eBay Dev Portal
EBAY_MAD_ENDPOINT=""
